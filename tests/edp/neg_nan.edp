// neg_nan.edp -- negative test: NaN value in the checkpoint field.
// ffcpWrite must fail collectively (kErrNonFinite).
//
// Run:  ff-mpirun -np 4 tests/edp/neg_nan.edp -v 0

load "./FreeFemCheckpoint"

macro dimension()2//
include "macro_ddm.idp"

int[int] n2o;
macro ThN2O()n2o//

mesh Th = square(32, 32, [x, y]);
mesh ThGlobal = Th;

DmeshCreate(Th);

fespace Vh(Th, P1);
fespace VhGlobal(ThGlobal, P1);

Vh u = cos(x - 0.5) * cos(y - 0.5);

u[][0] = sqrt(-1.0);              // NaN

int[int] gid = restrict(Vh, VhGlobal, n2o);

int n = ffcpWrite("neg_nan.ffio", gid, u[]);

if (mpirank == 0) {
    cout << "neg_nan: ffcpWrite returned " << n << endl;
    if (n == -19)
        cout << "NEG-NAN EXPECT-FAIL OK" << endl;
    else
        cout << "NEG-NAN UNEXPECTED RETURN " << n << endl;
}
