// neg_conflict.edp -- negative test: rank 0 perturbs ALL its local values by
// +1e-3, so overlapping duplicate DOFs shared with other ranks disagree.
// ffcpWrite must fail collectively with a "conflicting duplicate" error.
//
// Run:  ff-mpirun -np 4 tests/edp/neg_conflict.edp -v 0

load "./FreeFemCheckpoint"

macro dimension()2//
include "macro_ddm.idp"

int[int] n2o;
macro ThN2O()n2o//

mesh Th = square(32, 32, [x, y]);
mesh ThGlobal = Th;

DmeshCreate(Th);

fespace Vh(Th, P1);
fespace VhGlobal(ThGlobal, P1);

Vh u = cos(x - 0.5) * cos(y - 0.5);

if (mpirank == 0)
    for (int i = 0; i < u[].n; ++i)
        u[][i] += 1.0e-3;             // only rank 0 -> overlap copies disagree

int[int] gid = restrict(Vh, VhGlobal, n2o);

int n = ffcpWrite("neg_conflict.ffio", gid, u[]);

if (mpirank == 0) {
    cout << "neg_conflict: ffcpWrite returned " << n << endl;
    if (n == -17)
        cout << "NEG-CONFLICT EXPECT-FAIL OK" << endl;
    else
        cout << "NEG-CONFLICT UNEXPECTED RETURN " << n << endl;
}
