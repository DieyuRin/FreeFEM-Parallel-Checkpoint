// neg_inf.edp -- negative test: +Inf value in the checkpoint field.
// ffcpWrite must fail collectively (kErrNonFinite).
//
// Run:  ff-mpirun -np 4 tests/edp/neg_inf.edp -v 0

load "./FreeFemCheckpoint"

macro dimension()2//
include "macro_ddm.idp"

int[int] n2o;
macro ThN2O()n2o//

mesh Th = square(32, 32, [x, y]);
mesh ThGlobal = Th;

DmeshCreate(Th);

fespace Vh(Th, P1);
fespace VhGlobal(ThGlobal, P1);

Vh u = cos(x - 0.5) * cos(y - 0.5);

u[][0] = 1.0e308 * 1.0e308;       // +Inf (double overflow)

int[int] gid = restrict(Vh, VhGlobal, n2o);

int n = ffcpWrite("neg_inf.ffio", gid, u[]);

if (mpirank == 0) {
    cout << "neg_inf: ffcpWrite returned " << n << endl;
    if (n < 0)
        cout << "NEG-INF EXPECT-FAIL OK" << endl;
    else
        cout << "NEG-INF UNEXPECTED SUCCESS" << endl;
}
