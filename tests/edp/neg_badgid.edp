// neg_badgid.edp -- negative test: every gid shifted by +1 removes canonical
// gid 0 from the mapping (the writer infers Nglobal = max(gid)+1, so the
// shift is NOT out of range -- it creates a MISSING canonical DOF 0).
// ffcpWrite must fail collectively with kErrCanonicalization (-17).
//
// Run:  ff-mpirun -np 4 tests/edp/neg_badgid.edp -v 0

load "./FreeFemCheckpoint"

macro dimension()2//
include "macro_ddm.idp"

int[int] n2o;
macro ThN2O()n2o//

mesh Th = square(32, 32, [x, y]);
mesh ThGlobal = Th;

DmeshCreate(Th);

fespace Vh(Th, P1);
fespace VhGlobal(ThGlobal, P1);

Vh u = cos(x - 0.5) * cos(y - 0.5);

int[int] gid = restrict(Vh, VhGlobal, n2o);
for (int i = 0; i < gid.n; ++i)
    gid[i] = gid[i] + 1;              // max(gid) == VhGlobal.ndof -> out of range

int n = ffcpWrite("neg_badgid.ffio", gid, u[]);

if (mpirank == 0) {
    cout << "neg_badgid: ffcpWrite returned " << n << endl;
    if (n == -17)
        cout << "NEG-BADGID EXPECT-FAIL OK" << endl;
    else
        cout << "NEG-BADGID UNEXPECTED RETURN " << n << endl;
}
