// neg_tol_ok.edp -- duplicate-tolerance positive test: rank 0 perturbs ALL
// its local values by +1e-15 (within the 1e-12 relative tolerance).
// Overlapping duplicate copies disagree slightly but the write must SUCCEED.
//
// Run:  ff-mpirun -np 4 tests/edp/neg_tol_ok.edp -v 0

load "./FreeFemCheckpoint"

macro dimension()2//
include "macro_ddm.idp"

int[int] n2o;
macro ThN2O()n2o//

mesh Th = square(32, 32, [x, y]);
mesh ThGlobal = Th;

DmeshCreate(Th);

fespace Vh(Th, P1);
fespace VhGlobal(ThGlobal, P1);

Vh u = cos(x - 0.5) * cos(y - 0.5);

if (mpirank == 0)
    for (int i = 0; i < u[].n; ++i)
        u[][i] += 1.0e-15;

int[int] gid = restrict(Vh, VhGlobal, n2o);

int n = ffcpWrite("neg_tol_ok.ffio", gid, u[]);

if (mpirank == 0) {
    cout << "neg_tol_ok: ffcpWrite returned " << n << endl;
    if (n > 0)
        cout << "NEG-TOL EXPECT-SUCCESS OK" << endl;
    else
        cout << "NEG-TOL UNEXPECTED FAILURE" << endl;
}
