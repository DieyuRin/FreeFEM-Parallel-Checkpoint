// neg_read_badgid.edp -- negative test on the READ path: gid[] shifted by +1,
// so max(gid) >= Nglobal of the checkpoint.  ffcpRead must fail collectively
// (kErrGidRange).
//
// Run:  ff-mpirun -np 4 tests/edp/neg_read_badgid.edp -chk file.ffio -v 0

load "./FreeFemCheckpoint"

macro dimension()2//
include "macro_ddm.idp"

string fname = getARGV("-chk", "checkpoint_p1.ffio");

int[int] n2o;
macro ThN2O()n2o//

mesh Th = square(32, 32, [x, y]);
mesh ThGlobal = Th;

DmeshCreate(Th);

fespace Vh(Th, P1);
fespace VhGlobal(ThGlobal, P1);

Vh u = 0.0;

int[int] gid = restrict(Vh, VhGlobal, n2o);
for (int i = 0; i < gid.n; ++i)
    gid[i] = gid[i] + 1;

int n = ffcpRead(fname, gid, u[]);

if (mpirank == 0) {
    cout << "neg_read_badgid: ffcpRead returned " << n << endl;
    if (n < 0)
        cout << "NEG-READ-BADGID EXPECT-FAIL OK" << endl;
    else
        cout << "NEG-READ-BADGID UNEXPECTED SUCCESS" << endl;
}
